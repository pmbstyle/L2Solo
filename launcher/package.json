{
  "name": "l2solo-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Install, configure and run your L2Solo world",
  "homepage": "https://l2solo.com",
  "repository": { "type": "git", "url": "https://github.com/pmbstyle/L2Solo.git", "directory": "launcher" },
  "author": "L2Solo",
  "license": "SEE LICENSE IN LICENSE",
  "main": "main/index.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/run-ui-smoke.cjs",
    "test:packaged": "node scripts/run-packaged-smoke.cjs",
    "runtime": "node scripts/prepare-runtime.cjs",
    "release:server": "node scripts/package-server.cjs",
    "dist": "electron-builder --publish never",
    "pack": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "extract-zip": "2.0.1"
  },
  "devDependencies": {
    "archiver": "7.0.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "tar": "7.5.14"
  },
  "build": {
    "appId": "com.l2solo.launcher",
    "productName": "L2Solo Launcher",
    "icon": "assets/logo.png",
    "artifactName": "L2Solo-Launcher-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist", "buildResources": "assets" },
    "files": ["main/**", "renderer/**", "assets/**", "package.json", "LICENSE"],
    "asarUnpack": ["main/db-guard.cjs", "main/geodata.cjs"],
    "extraResources": [{ "from": "runtime", "to": "runtime" }],
    "mac": { "category": "public.app-category.games", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "artifactName": "L2Solo-Launcher-${version}-windows-${arch}-Setup.${ext}", "oneClick": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false },
    "portable": { "artifactName": "L2Solo-Launcher-${version}-windows-${arch}-Portable.${ext}" },
    "linux": { "category": "Game", "target": ["AppImage", "deb"], "maintainer": "pmbstyle" }
  }
}
